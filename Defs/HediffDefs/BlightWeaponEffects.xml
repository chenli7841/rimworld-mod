<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <HediffDef>
    <defName>LiAIChat_BlightSporeInfection</defName>
    <label>spore infection</label><labelNoun>spore infection</labelNoun>
    <description>Alien spores impair breathing and movement. At high severity, death releases a short toxic spore cloud.</description>
    <hediffClass>HediffWithComps</hediffClass><isBad>true</isBad><alwaysShowSeverity>true</alwaysShowSeverity>
    <initialSeverity>0</initialSeverity><maxSeverity>1</maxSeverity>
    <comps><li Class="LiAIChat.Blightfall.HediffCompProperties_BlightSporeInfection"><recoveryPerDay>0.01</recoveryPerDay><deathCloudThreshold>0.5</deathCloudThreshold></li></comps>
    <stages>
      <li><label>minor</label></li>
      <li><minSeverity>0.24</minSeverity><label>moderate</label><capMods><li><capacity>Breathing</capacity><offset>-0.05</offset></li></capMods><statFactors><MoveSpeed>0.97</MoveSpeed></statFactors></li>
      <li><minSeverity>0.48</minSeverity><label>severe</label><capMods><li><capacity>Breathing</capacity><offset>-0.15</offset></li></capMods><statFactors><MoveSpeed>0.92</MoveSpeed></statFactors></li>
      <li><minSeverity>0.75</minSeverity><label>dangerous</label><capMods><li><capacity>Breathing</capacity><offset>-0.25</offset></li></capMods><statFactors><MoveSpeed>0.85</MoveSpeed></statFactors></li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>LiAIChat_BlightArmorCorrosion</defName>
    <label>armor corrosion</label><labelNoun>corrosion</labelNoun>
    <description>Corrosive compounds temporarily weaken armor. Repeated hits stack up to three layers; further hits refresh the duration.</description>
    <hediffClass>HediffWithComps</hediffClass><isBad>true</isBad><alwaysShowSeverity>true</alwaysShowSeverity>
    <initialSeverity>0</initialSeverity><maxSeverity>0.24</maxSeverity>
    <comps><li Class="LiAIChat.Blightfall.HediffCompProperties_BlightArmorCorrosion"><durationTicks>1200</durationTicks><severityPerHit>0.08</severityPerHit><maxSeverity>0.24</maxSeverity></li></comps>
    <stages>
      <li><label>minor</label></li>
      <li><minSeverity>0.08</minSeverity><label>corroded</label></li>
      <li><minSeverity>0.16</minSeverity><label>heavily corroded</label></li>
      <li><minSeverity>0.24</minSeverity><label>severely corroded</label></li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>LiAIChat_NeuralDisruption</defName><label>neural disruption</label><labelNoun>neural disruption</labelNoun>
    <description>A resonance pulse interferes with the nervous system, temporarily reducing consciousness and manipulation.</description>
    <hediffClass>HediffWithComps</hediffClass><isBad>true</isBad><initialSeverity>1</initialSeverity><maxSeverity>1</maxSeverity>
    <comps><li Class="LiAIChat.Blightfall.HediffCompProperties_BlightTimedEffect"><durationTicks>1200</durationTicks></li></comps>
    <stages><li><label>disrupted</label><capMods><li><capacity>Consciousness</capacity><offset>-0.1</offset></li><li><capacity>Manipulation</capacity><offset>-0.08</offset></li></capMods></li></stages>
  </HediffDef>

  <HediffDef>
    <defName>LiAIChat_BlightSeedDisruption</defName><label>blight seed disruption</label><labelNoun>seed disruption</labelNoun>
    <description>Alien spores and bioelectric signals interfere with movement near a Blight seed.</description>
    <hediffClass>HediffWithComps</hediffClass><isBad>true</isBad><initialSeverity>1</initialSeverity><maxSeverity>1</maxSeverity>
    <comps><li Class="LiAIChat.Blightfall.HediffCompProperties_BlightTimedEffect"><durationTicks>300</durationTicks></li></comps>
    <stages><li><label>slowed</label><statFactors><MoveSpeed>0.9</MoveSpeed></statFactors></li></stages>
  </HediffDef>

  <HediffDef>
    <defName>LiAIChat_ShieldRecoveryDisrupted</defName><label>shield recovery disrupted</label><labelNoun>shield disruption</labelNoun>
    <description>A resonance pulse temporarily suppresses personal shield recharge.</description>
    <hediffClass>HediffWithComps</hediffClass><isBad>true</isBad><initialSeverity>1</initialSeverity><maxSeverity>1</maxSeverity>
    <comps><li Class="LiAIChat.Blightfall.HediffCompProperties_BlightTimedEffect"><durationTicks>600</durationTicks></li></comps>
  </HediffDef>

  <ThingDef ParentName="BaseBullet">
    <defName>LiAIChat_SporecasterBullet</defName><label>sporecaster round</label>
    <thingClass>LiAIChat.Blightfall.Projectile_BlightWeapon</thingClass>
    <graphicData><texPath>Things/Projectile/Bullet_Small</texPath><graphicClass>Graphic_Single</graphicClass><drawSize>0.65</drawSize></graphicData>
    <projectile><damageDef>Bullet</damageDef><damageAmountBase>12</damageAmountBase><speed>60</speed><stoppingPower>1</stoppingPower></projectile>
  </ThingDef>
  <ThingDef ParentName="BaseBullet">
    <defName>LiAIChat_CorrosionProjectorBolt</defName><label>corrosive bolt</label>
    <thingClass>LiAIChat.Blightfall.Projectile_BlightWeapon</thingClass>
    <graphicData><texPath>Things/Projectile/Bullet_Small</texPath><graphicClass>Graphic_Single</graphicClass><drawSize>0.8</drawSize></graphicData>
    <projectile><damageDef>Bullet</damageDef><damageAmountBase>9</damageAmountBase><armorPenetrationBase>0.35</armorPenetrationBase><speed>50</speed><stoppingPower>1</stoppingPower></projectile>
  </ThingDef>
</Defs>
