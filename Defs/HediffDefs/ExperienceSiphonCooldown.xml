<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>LiAIChat_ExperienceSiphonCooldown</defName>
    <label>experience siphon cooldown</label>
    <description>The prisoner needs time to recover before their experience can be siphoned again.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>1</initialSeverity>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <stages>
      <li>
        <minSeverity>0.01</minSeverity>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>120000~120000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>
</Defs>
