  <LiAIChat.Civilization.CivilizationKnowledgeDef>
    <defName>LiAIChat_CivKnowledge_ClassicalGreekPoliticalThought</defName>
    <label>Classical Greek Political Thought</label>
    <title>古典希腊政治思想</title>
    <titleChinese>古典希腊政治思想</titleChinese>
    <description>对古典希腊政治思想的重建，涵盖城邦、公民身份、正义、政体、政治权威与政治秩序等重要观念。</description>
    <descriptionChinese>对古典希腊政治思想的重建，涵盖城邦、公民身份、正义、政体、政治权威与政治秩序等重要观念。</descriptionChinese>
    <category>PoliticalThought</category>
    <prerequisites>
      <li>LiAIChat_CivKnowledge_AncientGreekPhilosophy</li>
    </prerequisites>
    <requiredTexts>
      <li>LiAIChat_Text_Plato_Republic</li>
      <li>LiAIChat_Text_Aristotle_Politics</li>
    </requiredTexts>
    <gracePeriodDays>10</gracePeriodDays>
    <dormantAfterDays>30</dormantAfterDays>
    <treeX>1100</treeX>
    <treeY>380</treeY>
  </LiAIChat.Civilization.CivilizationKnowledgeDef>


