<?xml version="1.0" encoding="utf-8"?>

<Defs>

  <!-- ========================================================= -->
  <!-- Ancient Greek Philosophy                                 -->
  <!-- 古希腊哲学                                                -->
  <!-- ========================================================= -->

  <LiAIChat.Civilization.CivilizationKnowledgeDef>
    <defName>LiAIChat_CivKnowledge_AncientGreekPhilosophy</defName>
    <label>Ancient Greek Philosophy</label>
    <title>古希腊哲学</title>
    <titleChinese>古希腊哲学</titleChinese>
    <description>对古希腊哲学传统的重建，包括柏拉图、亚里士多德等思想家的奠基性著作，以及他们对知识、现实、伦理与政治秩序的探索。</description>
    <descriptionChinese>对古希腊哲学传统的重建，包括柏拉图、亚里士多德等思想家的奠基性著作，以及他们对知识、现实、伦理与政治秩序的探索。</descriptionChinese>
    <category>Philosophy</category>
    <requiredTexts>
      <li>LiAIChat_Text_Plato_Republic</li>
    </requiredTexts>
    <effects>
      <colonyConversationContext>The colony has recovered classical Greek questions about justice, virtue, knowledge, and the proper ordering of a community.</colonyConversationContext>
    </effects>
    <gracePeriodDays>10</gracePeriodDays>
    <dormantAfterDays>30</dormantAfterDays>
    <treeX>850</treeX>
    <treeY>160</treeY>
  </LiAIChat.Civilization.CivilizationKnowledgeDef>


  <!-- ========================================================= -->
  <!-- Classical Greek Ethics                                   -->
  <!-- 古典希腊伦理学                                            -->
  <!-- ========================================================= -->

  <LiAIChat.Civilization.CivilizationKnowledgeDef>
    <defName>LiAIChat_CivKnowledge_GreekEthics</defName>
    <label>Classical Greek Ethics</label>
    <title>古典希腊伦理学</title>
    <titleChinese>古典希腊伦理学</titleChinese>
    <description>对古典希腊伦理思想的重建，探讨德性、品格、道德卓越、实践智慧以及何为美好人生等核心问题。</description>
    <descriptionChinese>对古典希腊伦理思想的重建，探讨德性、品格、道德卓越、实践智慧以及何为美好人生等核心问题。</descriptionChinese>
    <category>Philosophy</category>
    <prerequisites>
      <li>LiAIChat_CivKnowledge_AncientGreekPhilosophy</li>
    </prerequisites>
    <requiredTexts>
      <li>LiAIChat_Text_Aristotle_NicomacheanEthics</li>
    </requiredTexts>
    <gracePeriodDays>10</gracePeriodDays>
    <dormantAfterDays>30</dormantAfterDays>
    <treeX>450</treeX>
    <treeY>380</treeY>
  </LiAIChat.Civilization.CivilizationKnowledgeDef>


  <!-- ========================================================= -->
  <!-- Classical Greek Political Thought                        -->
  <!-- 古典希腊政治思想                                          -->
  <!-- ========================================================= -->

  <LiAIChat.Civilization.CivilizationKnowledgeDef>
    <defName>LiAIChat_CivKnowledge_ClassicalGreekPoliticalThought</defName>
    <label>Classical Greek Political Thought</label>
    <title>古典希腊政治思想</title>
    <titleChinese>古典希腊政治思想</titleChinese>
    <description>对古典希腊政治思想的重建，涵盖城邦、公民身份、正义、政体、政治权威与政治秩序等重要观念。</description>
    <descriptionChinese>对古典希腊政治思想的重建，涵盖城邦、公民身份、正义、政体、政治权威与政治秩序等重要观念。</descriptionChinese>
    <category>PoliticalThought</category>
    <prerequisites>
      <li>LiAIChat_CivKnowledge_AncientGreekPhilosophy</li>
    </prerequisites>
    <requiredTexts>
      <li>LiAIChat_Text_Plato_Republic</li>
      <li>LiAIChat_Text_Aristotle_Politics</li>
    </requiredTexts>
    <gracePeriodDays>10</gracePeriodDays>
    <dormantAfterDays>30</dormantAfterDays>
    <treeX>850</treeX>
    <treeY>380</treeY>
  </LiAIChat.Civilization.CivilizationKnowledgeDef>

  <LiAIChat.Civilization.CivilizationKnowledgeDef>
    <defName>LiAIChat_CivKnowledge_HellenisticPhilosophy</defName>
    <title>希腊化哲学</title>
    <titleChinese>Hellenistic Philosophy</titleChinese>
    <description>对希腊化时代及罗马时期主要哲学传统的重建，重点涉及德性、理性、自我节制、苦难以及何为美好人生等问题。</description>
    <descriptionChinese>Reconstruction of major philosophical traditions of the Hellenistic and Roman worlds, especially approaches to virtue, reason, self-discipline, suffering, and the good life.</descriptionChinese>
    <category>Philosophy</category>
    <prerequisites>
      <li>LiAIChat_CivKnowledge_AncientGreekPhilosophy</li>
    </prerequisites>
    <requiredTexts>
      <li>LiAIChat_Text_MarcusAurelius_Meditations</li>
    </requiredTexts>
    <treeX>1250</treeX>
    <treeY>380</treeY>
  </LiAIChat.Civilization.CivilizationKnowledgeDef>

  <LiAIChat.Civilization.CivilizationKnowledgeDef>
    <defName>LiAIChat_CivKnowledge_MedievalPhilosophy</defName>
    <title>中世纪哲学</title>
    <titleChinese>Medieval Philosophy</titleChinese>
    <description>对中世纪哲学思想的重建，涵盖上帝、理性与信仰、人的本性、历史、道德以及政治秩序等核心问题。</description>
    <descriptionChinese>Reconstruction of medieval philosophical thought concerning God, reason, faith, human nature, history, morality, and political order.</descriptionChinese>
    <category>Philosophy</category>
    <prerequisites>
      <li>LiAIChat_CivKnowledge_HellenisticPhilosophy</li>
    </prerequisites>
    <requiredTexts>
      <li>LiAIChat_Text_Augustine_Confessions</li>
      <li>LiAIChat_Text_Augustine_CityOfGod</li>
    </requiredTexts>
    <treeX>1250</treeX>
    <treeY>600</treeY>
  </LiAIChat.Civilization.CivilizationKnowledgeDef>

  <LiAIChat.Civilization.CivilizationKnowledgeDef>
    <defName>LiAIChat_CivKnowledge_EarlyModernPhilosophy</defName>
    <title>近代早期哲学</title>
    <titleChinese>Early Modern Philosophy</titleChinese>
    <description>对近代早期哲学转型的重建，包括关于知识、方法、理性、观察以及自然研究的新思想。</description>
    <descriptionChinese>Reconstruction of the early modern transformation of philosophy, including new approaches to knowledge, method, reason, observation, and the investigation of nature.</descriptionChinese>
    <category>Philosophy</category>
    <prerequisites>
      <li>LiAIChat_CivKnowledge_MedievalPhilosophy</li>
    </prerequisites>
    <requiredTexts>
      <li>LiAIChat_Text_Bacon_NovumOrganum</li>
    </requiredTexts>
    <effects>
      <colonyConversationContext>The colony recognizes systematic observation, careful method, and the testing of assumptions as valuable ways to investigate nature.</colonyConversationContext>
    </effects>
    <treeX>1250</treeX>
    <treeY>820</treeY>
  </LiAIChat.Civilization.CivilizationKnowledgeDef>

  <LiAIChat.Civilization.CivilizationKnowledgeDef>
    <defName>LiAIChat_CivKnowledge_Rationalism</defName>
    <title>理性主义</title>
    <titleChinese>Rationalism</titleChinese>
    <description>对近代理性主义传统的重建，强调理性、系统性怀疑，以及对确定知识基础的探索。</description>
    <descriptionChinese>Reconstruction of the early modern rationalist tradition emphasizing reason, systematic doubt, and the search for foundations of certain knowledge.</descriptionChinese>
    <category>Philosophy</category>
    <prerequisites>
      <li>LiAIChat_CivKnowledge_EarlyModernPhilosophy</li>
    </prerequisites>
    <requiredTexts>
      <li>LiAIChat_Text_Descartes_Meditations</li>
    </requiredTexts>
    <treeX>1000</treeX>
    <treeY>1040</treeY>
  </LiAIChat.Civilization.CivilizationKnowledgeDef>

  <LiAIChat.Civilization.CivilizationKnowledgeDef>
    <defName>LiAIChat_CivKnowledge_Empiricism</defName>
    <title>经验主义</title>
    <titleChinese>Empiricism</titleChinese>
    <description>对经验主义传统的重建，强调经验与观察，并批判性地考察人类知识的来源及其界限。</description>
    <descriptionChinese>Reconstruction of the empiricist tradition emphasizing experience, observation, and critical investigation of the origins and limits of human knowledge.</descriptionChinese>
    <category>Philosophy</category>
    <prerequisites>
      <li>LiAIChat_CivKnowledge_EarlyModernPhilosophy</li>
    </prerequisites>
    <requiredTexts>
      <li>LiAIChat_Text_Locke_EssayHumanUnderstanding</li>
      <li>LiAIChat_Text_Hume_EnquiryHumanUnderstanding</li>
    </requiredTexts>
    <treeX>1500</treeX>
    <treeY>1040</treeY>
  </LiAIChat.Civilization.CivilizationKnowledgeDef>

  <LiAIChat.Civilization.CivilizationKnowledgeDef>
    <defName>LiAIChat_CivKnowledge_KantianPhilosophy</defName>

    <title>康德哲学</title>
    <titleChinese>Kantian Philosophy</titleChinese>
    <description>对康德批判哲学的重建，探讨人类知识的条件与界限、道德理性、自由，以及经验与理性思维之间的关系。</description>
    <descriptionChinese>Reconstruction of Kant's critical philosophy, addressing the conditions and limits of human knowledge, moral reason, freedom, and the relation between experience and rational thought.</descriptionChinese>
    <category>Philosophy</category>
    <prerequisites>
      <li>LiAIChat_CivKnowledge_Rationalism</li>
      <li>LiAIChat_CivKnowledge_Empiricism</li>
    </prerequisites>
    <requiredTexts>
      <li>LiAIChat_Text_Kant_CritiqueOfPureReason</li>
      <li>LiAIChat_Text_Kant_CritiqueOfPracticalReason</li>
    </requiredTexts>
    <effects>
      <colonyConversationContext>The colony can discuss the limits of human knowledge, moral duty, freedom, and the relationship between experience and reason.</colonyConversationContext>
    </effects>
    <treeX>1250</treeX>
    <treeY>1260</treeY>
  </LiAIChat.Civilization.CivilizationKnowledgeDef>


