    <costList><ComponentIndustrial>6</ComponentIndustrial><ComponentSpacer>3</ComponentSpacer><Plasteel>55</Plasteel><LiAIChat_BlightResearchData>2</LiAIChat_BlightResearchData></costList>
    <recipeMaker><researchPrerequisite>LiAIChat_ResonanceTechnology</researchPrerequisite><skillRequirements><Crafting>8</Crafting></skillRequirements><displayPriority>126</displayPriority></recipeMaker>
