<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="ResourceBase">
    <defName>LiAIChat_WritingPaper</defName><label>书写纸</label>
    <description>适合保存文字的纸张，用于文献创作。</description>
    <thingCategories><li>Manufactured</li></thingCategories>
    <graphicData><texPath>Things/Item/Commentary/WritingPaper</texPath><graphicClass>Graphic_Single</graphicClass><drawSize>0.45</drawSize></graphicData>
    <statBases><MarketValue>1.2</MarketValue><Mass>0.02</Mass><Flammability>1</Flammability><WorkToMake>80</WorkToMake></statBases>
    <costList><Cloth>5</Cloth></costList>
    <recipeMaker><workAmount>500</workAmount><workSkill>Artistic</workSkill><recipeUsers><li>TableSculpting</li></recipeUsers><researchPrerequisite>LiAIChat_PaperMaking</researchPrerequisite><productCount>20</productCount></recipeMaker>
  </ThingDef>
  <ThingDef ParentName="ResourceBase">
    <defName>LiAIChat_SteelPen</defName><label>钢笔</label>
    <description>一支钢制的墨笔，可用于长篇书写。连续书写约十二小时后会耗尽。</description>
    <thingCategories><li>Manufactured</li></thingCategories>
    <graphicData><texPath>Things/Item/Commentary/SteelPen</texPath><graphicClass>Graphic_Single</graphicClass><drawSize>0.35</drawSize></graphicData>
    <statBases><MarketValue>8</MarketValue><Mass>0.05</Mass><Flammability>0.6</Flammability><WorkToMake>180</WorkToMake></statBases>
    <costList><WoodLog>4</WoodLog><Steel>1</Steel></costList>
    <recipeMaker><workAmount>900</workAmount><workSkill>Artistic</workSkill><recipeUsers><li>TableSculpting</li></recipeUsers><researchPrerequisite>LiAIChat_InkPenCrafting</researchPrerequisite></recipeMaker>
  </ThingDef>
  <ThingDef ParentName="ResourceBase">
    <defName>LiAIChat_SilverPen</defName><label>银笔</label>
    <description>一支银制墨笔。书写时的仪式感有助于维持作者的心情，并稍微减慢娱乐和休息的消耗；连续书写约十二小时后会耗尽。</description>
    <thingCategories><li>Manufactured</li></thingCategories>
    <graphicData><texPath>Things/Item/Commentary/SilverPen</texPath><graphicClass>Graphic_Single</graphicClass><drawSize>0.35</drawSize></graphicData>
    <statBases><MarketValue>35</MarketValue><Mass>0.05</Mass><Flammability>0.4</Flammability><WorkToMake>240</WorkToMake></statBases>
    <costList><WoodLog>4</WoodLog><Silver>12</Silver></costList>
    <recipeMaker><workAmount>1200</workAmount><workSkill>Artistic</workSkill><recipeUsers><li>TableSculpting</li></recipeUsers><researchPrerequisite>LiAIChat_InkPenCrafting</researchPrerequisite></recipeMaker>
  </ThingDef>
  <ThingDef ParentName="ResourceBase">
    <defName>LiAIChat_GoldPen</defName><label>金笔</label>
    <description>一支金制墨笔。其奢华与庄重能显著维持作者的心情，并减慢娱乐和休息的消耗；连续书写约十二小时后会耗尽。</description>
    <thingCategories><li>Manufactured</li></thingCategories>
    <graphicData><texPath>Things/Item/Commentary/GoldPen</texPath><graphicClass>Graphic_Single</graphicClass><drawSize>0.35</drawSize></graphicData>
    <statBases><MarketValue>90</MarketValue><Mass>0.05</Mass><Flammability>0.3</Flammability><WorkToMake>300</WorkToMake></statBases>
    <costList><WoodLog>4</WoodLog><Gold>6</Gold></costList>
    <recipeMaker><workAmount>1500</workAmount><workSkill>Artistic</workSkill><recipeUsers><li>TableSculpting</li></recipeUsers><researchPrerequisite>LiAIChat_InkPenCrafting</researchPrerequisite></recipeMaker>
  </ThingDef>
</Defs>
