    <tags><li>LiAIChat_BlightfallToxicHive</li></tags>
  </SitePartDef>
  <SitePartDef>
    <defName>LiAIChat_BlightfallProcessingPlant</defName>
    <label>Blightfall ancient processing plant</label>
    <description>An uncontrolled ancient facility that continuously contaminates its surroundings.</description>
    <workerClass>LiAIChat.Blightfall.SitePartWorker_BlightfallContaminatedRuin</workerClass>
    <siteTexture>World/WorldObjects/Sites/GenericSite</siteTexture>
    <expandingIconTexture>World/WorldObjects/Expanding/Sites/Outpost</expandingIconTexture>
    <gravShipsCanLandOn>true</gravShipsCanLandOn>
    <tags><li>LiAIChat_BlightfallProcessingPlant</li></tags>
  </SitePartDef>

  <SitePartDef>
    <defName>LiAIChat_BlightfallResonanceDefense</defName>
    <label>Blightfall resonance defense site</label>
    <description>A heavily defended resonance spire projects a local shield that protects the Blightfall core.</description>
    <workerClass>LiAIChat.Blightfall.SitePartWorker_BlightfallContaminatedRuin</workerClass>
    <siteTexture>World/WorldObjects/Sites/GenericSite</siteTexture>
    <expandingIconTexture>World/WorldObjects/Expanding/Sites/Outpost</expandingIconTexture>
