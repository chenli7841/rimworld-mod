  <SitePartDef>
    <defName>LiAIChat_BlightfallBlightHeart</defName>
    <label>Blightfall core</label>
    <description>The exposed heart of the Blightfall network. Destroy its defenses, survive its reinforcements, and destroy the heart to end the campaign.</description>
    <workerClass>LiAIChat.Blightfall.SitePartWorker_BlightfallContaminatedRuin</workerClass>
    <siteTexture>World/WorldObjects/Sites/GenericSite</siteTexture>
    <expandingIconTexture>World/WorldObjects/Expanding/Sites/Outpost</expandingIconTexture>
    <gravShipsCanLandOn>true</gravShipsCanLandOn>
