<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <SitePartDef>
    <defName>LiAIChat_BlightfallContaminatedRuin</defName>
    <label>Blightfall contaminated ruin</label>
    <description>An abandoned ruin in the Blightfall contamination zone, covered in pollution and toxic wastepacks.</description>
    <workerClass>LiAIChat.Blightfall.SitePartWorker_BlightfallContaminatedRuin</workerClass>
    <siteTexture>World/WorldObjects/Sites/GenericSite</siteTexture>
    <expandingIconTexture>World/WorldObjects/Expanding/Sites/ItemStash</expandingIconTexture>
    <gravShipsCanLandOn>true</gravShipsCanLandOn>
    <tags>
      <li>LiAIChat_BlightfallContaminatedRuin</li>
    </tags>
  </SitePartDef>

  <SitePartDef>
    <defName>LiAIChat_BlightfallSporeForest</defName>
    <label>Blightfall spore forest</label>
    <description>A polluted grove dominated by a living spore mother tree.</description>
    <workerClass>LiAIChat.Blightfall.SitePartWorker_BlightfallContaminatedRuin</workerClass>
    <siteTexture>World/WorldObjects/Sites/GenericSite</siteTexture>
    <expandingIconTexture>World/WorldObjects/Expanding/Sites/Manhunters</expandingIconTexture>
    <gravShipsCanLandOn>true</gravShipsCanLandOn>
    <tags><li>LiAIChat_BlightfallSporeForest</li></tags>
  </SitePartDef>
  <SitePartDef>
    <defName>LiAIChat_BlightfallToxicHive</defName>
