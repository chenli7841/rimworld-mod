  <GenStepDef>
    <defName>LiAIChat_BlightfallContaminatedRuin_Ruins</defName>
    <linkWithSite>LiAIChat_BlightfallContaminatedRuin</linkWithSite>
    <order>760</order>
    <genStep Class="GenStep_ScatterRuinsSimple">
      <allowInWaterBiome>false</allowInWaterBiome>
      <countPer10kCellsRange>1~2</countPer10kCellsRange>
      <canBeOnEdge>true</canBeOnEdge>
      <ignoreUsedRects>true</ignoreUsedRects>
    </genStep>
  </GenStepDef>

  <GenStepDef>
    <defName>LiAIChat_BlightfallContaminatedRuin_Generation</defName>
    <linkWithSite>LiAIChat_BlightfallContaminatedRuin</linkWithSite>
    <order>980</order>
    <genStep Class="LiAIChat.Blightfall.GenStep_BlightfallContaminatedRuin" />
  </GenStepDef>

