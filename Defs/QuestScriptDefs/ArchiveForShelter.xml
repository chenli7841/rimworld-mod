<?xml version="1.0" encoding="utf-8"?>

<Defs>

  <QuestScriptDef>
    <defName>LiAIChat_ArchiveForShelter</defName>

    <root Class="QuestNode_Sequence">

      <nodes>

        <li Class="LiAIChat.Questing.QuestNode_CreateArchiveRefugees">
          <storeAs>refugees</storeAs>
          <storeFactionAs>refugeeFaction</storeFactionAs>
        </li>
        <li Class="LiAIChat.Questing.QuestNode_GiveArchiveToRefugeeGroup">
          <pawns>$refugees</pawns>
          <storeArchiveAs>refugeeArchive</storeArchiveAs>
          <storeGroupIdAs>refugeeGroupId</storeGroupIdAs>
          <storeLeaderAs>refugeeLeader</storeLeaderAs>
          <exitSignal>$refugeeExitSignal</exitSignal>
          <failureSignal>$refugeeFailureSignal</failureSignal>
        </li>
        <li Class="QuestNode_ExtraFaction">
          <faction>$refugeeFaction</faction>
          <pawns>$refugees</pawns>
          <factionType>HomeFaction</factionType>
        </li>

        <li Class="QuestNode_PawnsArrive">
          <pawns>$refugees</pawns>
          <joinPlayer>true</joinPlayer>
        </li>

        <li Class="QuestNode_LeaveOnCleanup">
          <pawns>$refugees</pawns>
          <sendStandardLetter>false</sendStandardLetter>
        </li>

        <li Class="LiAIChat.Questing.QuestNode_CreateUniqueSignal">
          <storeAs>refugeeExitSignal</storeAs>
          <prefix>LiAIChat_RefugeesExited</prefix>
        </li>

        <li Class="LiAIChat.Questing.QuestNode_CreateUniqueSignal">
          <storeAs>refugeeFailureSignal</storeAs>
          <prefix>LiAIChat_RefugeesFailed</prefix>
        </li>

        <li Class="QuestNode_Delay">
          <delayTicks>600</delayTicks>
          <outSignal>RefugeeStayFinished</outSignal>
        </li>

        <li Class="LiAIChat.Questing.QuestNode_FinalizeArchiveRefugeeStay">
          <inSignal>RefugeeStayFinished</inSignal>
          <groupId>$refugeeGroupId</groupId>
          <pawns>$refugees</pawns>
        </li>

      </nodes>

    </root>


    <questNameRules>
      <rulesStrings>
        <li>questName->Archive for Shelter</li>
      </rulesStrings>
    </questNameRules>


    <questDescriptionRules>
      <rulesStrings>
        <li>questDescription->A small group of travelers has arrived seeking temporary shelter. They claim to be carrying knowledge preserved from ancient Earth.</li>
      </rulesStrings>
    </questDescriptionRules>

  </QuestScriptDef>

</Defs>