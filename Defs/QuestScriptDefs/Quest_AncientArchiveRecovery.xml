<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <QuestScriptDef>
    <defName>LiAIChat_AncientArchiveRecovery</defName>

    <!-- Relative storyteller selection weight, not an absolute probability. -->
    <rootSelectionWeight>0.5</rootSelectionWeight>
    <rootMinPoints>400</rootMinPoints>
    <!-- Measured from the previous quest's appearance, not its completion. -->
    <minRefireDays>15</minRefireDays>
    <autoAccept>true</autoAccept>
    <questNameRules>
      <rulesStrings>
        <li>questName->Ancient Earth archive signal</li>
      </rulesStrings>
    </questNameRules>
    <questDescriptionRules>
      <rulesStrings>
        <li>questDescription->An ancient signal has revealed an archive site near [map_definite]. Preserved records from Earth may remain inside. Sleeping mechanoids guard the area.\n\nReach the site within 20 days. Once the site map is first generated, you have 30 more days to bring at least one record from this site to any player colony. Records carried in pawn or animal inventories count when they arrive. Losing or selling every record will fail the recovery.</li>
      </rulesStrings>
    </questDescriptionRules>
    <root Class="QuestNode_Sequence">
      <nodes>
        <!-- Only one ongoing recovery with this tag; ended quests may repeat. -->
        <li Class="QuestNode_QuestUnique">
          <tag>LiAIChat_AncientArchiveRecovery_Active</tag>
        </li>
        <!-- This version always includes mechanoids; respect difficulty settings. -->
        <li Class="QuestNode_ViolentQuestsAllowed" />
        <li Class="QuestNode_EqualOrFail">
          <value1>$allowViolentQuests</value1>
          <value2>true</value2>
          <compareAs>System.Boolean</compareAs>
        </li>
        <li Class="QuestNode_GetMap">
          <canBeSpace>false</canBeSpace>
        </li>
        <li Class="QuestNode_Set">
          <name>siteDistRange</name>
          <value>4~12</value>
        </li>
        <li Class="QuestNode_GetSiteTile">
          <storeAs>siteTile</storeAs>
          <preferCloserTiles>true</preferCloserTiles>
          <canSelectSpace>false</canSelectSpace>
          <selectLandmarkChance>0</selectLandmarkChance>
        </li>
        <li Class="QuestNode_GetSitePartDefsByTagsAndFaction">
          <storeAs>sitePartDefs</storeAs>
          <storeFactionAs>siteFaction</storeFactionAs>
          <sitePartsTags>
            <li>
              <tag>LiAIChat_AncientArchiveSite</tag>
              <chance>1</chance>
            </li>
            <li>
              <tag>SleepingMechanoids</tag>
              <chance>1</chance>
            </li>
          </sitePartsTags>
        </li>
        <li Class="QuestNode_GetDefaultSitePartsParams">
          <tile>$siteTile</tile>
          <faction>$siteFaction</faction>
          <sitePartDefs>$sitePartDefs</sitePartDefs>
          <storeSitePartsParamsAs>sitePartsParams</storeSitePartsParamsAs>
        </li>
        <li Class="QuestNode_SubScript">
          <def>Util_GenerateSite</def>
          <parms>
            <hiddenSitePartsPossible>false</hiddenSitePartsPossible>
          </parms>
        </li>
        <li Class="QuestNode_SpawnWorldObjects">
          <worldObjects>$site</worldObjects>
        </li>
        <li Class="QuestNode_WorldObjectTimeout">
          <worldObject>$site</worldObject>
          <isQuestTimeout>true</isQuestTimeout>
          <delayTicks>1200000</delayTicks>
          <inSignalDisable>site.MapGenerated</inSignalDisable>
          <node Class="QuestNode_End">
            <outcome>Fail</outcome>
          </node>
        </li>
        <li Class="LiAIChat.Questing.QuestNode_WaitForArchiveRecovery">
          <site>$site</site>
        </li>
        <!-- Starts when the site map is first generated, not on quest appearance. -->
        <li Class="QuestNode_Delay">
          <inSignalEnable>site.MapGenerated</inSignalEnable>
          <delayTicks>1800000</delayTicks>
          <reactivatable>false</reactivatable>
          <isQuestTimeout>true</isQuestTimeout>
          <node Class="QuestNode_End">
            <outcome>Fail</outcome>
          </node>
        </li>
      </nodes>
    </root>

  </QuestScriptDef>

</Defs>
