<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <ResearchProjectDef>
    <defName>LiAIChat_SporeBioengineering</defName><label>Spore Bioengineering</label>
    <description>Study the structure and controlled behavior of Blightfall spores. Requires the Spore Bioengineering blueprint and 3 units of Blight research data when research begins.</description>
    <baseCost>2000</baseCost><techLevel>Spacer</techLevel><requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding><researchViewX>1</researchViewX><researchViewY>11</researchViewY>
    <prerequisites><li>MicroelectronicsBasics</li></prerequisites>
    <modExtensions><li Class="LiAIChat.Blightfall.BlightTechnologyProjectExtension"><blueprintDefName>LiAIChat_SporeBioengineeringBlueprint</blueprintDefName><researchDataCost>3</researchDataCost></li></modExtensions>
  </ResearchProjectDef>
  <ResearchProjectDef>
    <defName>LiAIChat_CorrosiveTechnology</defName><label>Corrosive Technology</label>
    <description>Study the Blightfall's corrosive compounds and how to control them. Requires the Corrosive Technology blueprint and 4 units of Blight research data when research begins.</description>
    <baseCost>2500</baseCost><techLevel>Spacer</techLevel><requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding><researchViewX>3</researchViewX><researchViewY>11</researchViewY>
    <prerequisites><li>MicroelectronicsBasics</li><li>LiAIChat_SporeBioengineering</li></prerequisites>
    <modExtensions><li Class="LiAIChat.Blightfall.BlightTechnologyProjectExtension"><blueprintDefName>LiAIChat_CorrosiveTechnologyBlueprint</blueprintDefName><researchDataCost>4</researchDataCost></li></modExtensions>
  </ResearchProjectDef>
  <ResearchProjectDef>
    <defName>LiAIChat_SymbioticArmor</defName><label>Symbiotic Armor</label>
