    <baseCost>3000</baseCost><techLevel>Spacer</techLevel><requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding><researchViewX>5</researchViewX><researchViewY>11</researchViewY>
    <prerequisites><li>MicroelectronicsBasics</li><li>LiAIChat_CorrosiveTechnology</li></prerequisites>
    <modExtensions><li Class="LiAIChat.Blightfall.BlightTechnologyProjectExtension"><blueprintDefName>LiAIChat_SymbioticArmorBlueprint</blueprintDefName><researchDataCost>5</researchDataCost></li></modExtensions>
  </ResearchProjectDef>
  <ResearchProjectDef>
