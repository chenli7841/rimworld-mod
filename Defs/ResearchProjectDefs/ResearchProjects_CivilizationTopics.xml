        </bonuses>
      </li>
    </modExtensions>
    <baseCost>3000</baseCost><techLevel>Industrial</techLevel><tab>LiAIChat_CivilizationTopics</tab><researchViewX>3</researchViewX><researchViewY>1</researchViewY>
  </ResearchProjectDef>
  <ResearchProjectDef>
    <defName>LiAIChat_Topic_CityOfGod</defName>
    <label>专题：上帝之城</label>
    <description>围绕共同体、历史与世俗权力开展专题研讨。需要殖民地收藏已识别的《上帝之城》。完成后随机获得一项持续 7 天的殖民者加成。</description>
