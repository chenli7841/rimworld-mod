          <li><id>forbearance</id><label>共同体宽容：负面社交记忆的好感惩罚 −25%</label><effect>NegativeSocialMemory</effect><factor>0.75</factor></li>
          <li><id>hope</id><label>共同体的希望：殖民者心情 +4</label><effect>ColonyMood</effect><offset>4</offset></li>
          <li><id>gathering</id><label>共享意义：聚会、婚礼、音乐会及仪式的正面心情记忆效果 +25%</label><effect>GatheringMood</effect><factor>1.25</factor></li>
        </bonuses>
      </li>
    </modExtensions>
    <baseCost>3000</baseCost><techLevel>Industrial</techLevel><tab>LiAIChat_CivilizationTopics</tab><researchViewX>5</researchViewX><researchViewY>1</researchViewY>
  </ResearchProjectDef>
